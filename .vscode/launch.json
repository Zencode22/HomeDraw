{
    // Debug configurations for VS Codium.
    // Requirements:
    //   1. .NET 8 SDK available on PATH.
    //   2. A C# extension that provides the netcoredbg debug adapter, e.g. "cs-dev"
    //      from Open VSX (see .vscode/extensions.json). The adapter type used here is "netcoredbg".
    //      If your extension registers a different type (e.g. "coreclr"), change "type" accordingly.
    //   3. Content built once before launching (done automatically by the preLaunchTask below).
    "version": "0.2.0",
    "configurations": [
        {
            // Launch and debug the game (press F5)
            "name": "Debug HomeDraw (MonoGame)",
            "type": "netcoredbg",
            "request": "launch",
            "assembly": "${workspaceFolder}/HomeDraw/bin/Debug/net8.0/HomeDraw.dll",
            "cwd": "${workspaceFolder}/HomeDraw",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build HomeDraw",
            "env": {
                "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
            }
        },
        {
            // Launch and debug the texture generator tool (press F5 after selecting it)
            "name": "Debug TextureGenerator (console)",
            "type": "netcoredbg",
            "request": "launch",
            "assembly": "${workspaceFolder}/TextureGenerator/bin/Debug/net8.0/TextureGenerator.dll",
            "cwd": "${workspaceFolder}/TextureGenerator",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build TextureGenerator",
            "env": {
                "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
            }
        },
        {
            // Attach to an already-running game process (pick HomeDraw from the process list)
            "name": "Attach to HomeDraw process",
            "type": "netcoredbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
